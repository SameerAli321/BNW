NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:8080

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=BNW
DB_USER=postgres
DB_PASSWORD=YOUR_DB_PASSWORD

JWT_ACCESS_SECRET=YOUR_JWT_ACCESS_SECRET
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=YOUR_JWT_REFRESH_SECRET
JWT_REFRESH_EXPIRES=7d

# Outgoing email (interview invitations etc.) — BNW's own mail server. Port 465 = SSL.
# Emails are only logged to the console until SMTP_USER and SMTP_PASS are filled in.
SMTP_HOST=mail.bnwaccountants.co.uk
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Optional — where candidates' replies go, if not the MAIL_FROM mailbox.
MAIL_REPLY_TO=
